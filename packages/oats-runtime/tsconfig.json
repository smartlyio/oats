{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "target": "es2022",
    "lib": ["es2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "sourceMap": true,
    "removeComments": false,
    "alwaysStrict": true,
    "paths": {
      "@smartlyio/oats-runtime": ["./src/runtime"]
    },
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["node_modules/*", "*/**/dist/*", "dist/*", "test/"],
}
